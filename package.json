{
	"name": "credd-bot-ts",
	"version": "0.1.0",
	"description": "RPG Discord bot rewritten in TypeScript, OOP + design patterns, drizzle-orm/SQLite.",
	"type": "module",
	"main": "dist/index.js",
	"packageManager": "pnpm@12.4.1",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node scripts/check-dist-imports.mjs",
		"start": "node dist/index.js",
		"deploy:commands": "tsx src/scripts/deployCommands.ts",
		"deploy:commands:guild": "tsx src/scripts/deployCommands.ts --guild",
		"undeploy:commands": "tsx src/scripts/clearCommands.ts",
		"undeploy:commands:guild": "tsx src/scripts/clearCommands.ts --guild",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/db/migrate.ts",
		"db:seed": "tsx src/seed/seed.ts",
		"db:studio": "drizzle-kit studio",
		"lint": "eslint src",
		"lint:check": "eslint src",
		"format": "prettier --write \"src/**/*.ts\"",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"check": "pnpm lint:check && pnpm typecheck && pnpm check:text && pnpm test && pnpm check:links",
		"check:text": "node scripts/check-text-boundaries.mjs",
		"check:links": "node scripts/check-markdown-links.mjs README.md docs/audit-deployment.md",
		"test:postgres": "vitest run tests/postgres-concurrency.test.ts",
		"season:rollover": "tsx src/scripts/rolloverSeason.ts"
	},
	"dependencies": {
		"@napi-rs/canvas": "^1.0.9",
		"discord.js": "^14.27.0",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"pg": "^8.23.0",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"wrand": "^1.2.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.8",
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.20.3",
		"@types/pg": "^8.23.1",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.9.7",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vitest": "^5.0.1"
	},
	"engines": {
		"node": ">=20"
	}
}
