DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DATABASE_URL=postgres://user:password@localhost:5432/credd
LOG_LEVEL=info
# Tuỳ chọn — webhook Discord nhận embed lỗi error/fatal; để trống để tắt
ERROR_WEBHOOK_URL=
# Discord ID của chủ bot (phân tách bằng dấu ",") — bắt buộc để dùng /reset
OWNER_DISCORD_IDS=
# Tuỳ chọn — guild deploy mặc định cho deploy:commands trên server thử nghiệm
DEPLOY_GUILD_ID=

# Donation/supporter runtime is disabled until the provider contract is configured.
SUPPORTER_DONATIONS_ENABLED=false
SUPPORTER_TIERS_JSON=
SUPPORTER_DONATION_MIN_AMOUNT=
SUPPORTER_DONATION_MAX_AMOUNT=
SUPPORTER_ORDER_TTL_MINUTES=30
SEPAY_WEBHOOK_API_KEY=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_BANK_NAME=
SEPAY_EXPECTED_GATEWAY=
SEPAY_WEBHOOK_HOST=0.0.0.0
SEPAY_WEBHOOK_PORT=8787
SEPAY_WEBHOOK_PATH=/webhooks/sepay
KEYGATE_BASE_URL=
KEYGATE_ADMIN_TOKEN=
KEYGATE_PRODUCT_ID=
KEYGATE_CONTRACT_VERIFIED=false
