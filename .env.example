DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DATABASE_URL=postgres://user:password@localhost:5432/credd
LOG_LEVEL=info
# Tuỳ chọn — webhook Discord nhận embed lỗi error/fatal; để trống để tắt
ERROR_WEBHOOK_URL=
# Discord ID của chủ bot (phân tách bằng dấu ",") — bắt buộc để dùng /reset
OWNER_DISCORD_IDS=
# Tuỳ chọn — guild deploy mặc định cho deploy:commands trên server thử nghiệm
DEPLOY_GUILD_ID=
# Tuỳ chọn — đặt 1 để bỏ qua deploy slash commands khi khởi động container
# (dùng khi lệnh không đổi, boot nhanh và tránh rate-limit Discord)
#SKIP_DEPLOY=0
# Chỉ dùng cho CI — URL Postgres dùng một lần để chạy suite concurrency
# (tests/postgres-concurrency.test.ts); không bao giờ trỏ vào DB thật
#TEST_DATABASE_URL=
# Tuỳ chọn — test server: rút ngắn cooldown raid để test nhanh
# (mặc định prod: hunt 15 giây, boss 1 lượt/ngày lịch VN; BOSS_COOLDOWN_MINUTES=0 giữ luật ngày)
#HUNT_COOLDOWN_SECONDS=2
#BOSS_COOLDOWN_MINUTES=15
